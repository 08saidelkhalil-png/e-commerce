{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section">
  <div class="mt-wrap mt-pad">
    <div class="mt-quote-carousel" data-mt-carousel>
      {% for block in section.blocks %}
        <div class="mt-quote-slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <div class="mt-quote__mark">"</div>
          <div class="mt-quote__stars">★★★★★</div>
          <h3 class="mt-quote__headline">{{ block.settings.headline }}</h3>
          <p class="mt-quote__body">{{ block.settings.text }}</p>
          <div class="mt-quote__name">{{ block.settings.name }}</div>
        </div>
      {% endfor %}
      <div class="mt-carousel-nav">
        <button type="button" data-mt-carousel-prev aria-label="Anterior">‹</button>
        <div class="mt-gallery__dots" data-mt-carousel-dots>
          {% for block in section.blocks %}
            <span class="mt-gallery__dot{% if forloop.first %} is-active{% endif %}"></span>
          {% endfor %}
        </div>
        <button type="button" data-mt-carousel-next aria-label="Siguiente">›</button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  document.querySelectorAll('[data-mt-carousel]').forEach(function(c){
    var slides = c.querySelectorAll('.mt-quote-slide, .mt-review-slide');
    if(!slides.length) return;
    var dots = c.querySelectorAll('[data-mt-carousel-dots] .mt-gallery__dot');
    var prev = c.querySelector('[data-mt-carousel-prev]');
    var next = c.querySelector('[data-mt-carousel-next]');
    var i = 0;
    function show(n){
      i = (n + slides.length) % slides.length;
      slides.forEach(function(s, idx){ s.classList.toggle('is-active', idx === i); });
      dots.forEach(function(d, idx){ d.classList.toggle('is-active', idx === i); });
    }
    if(prev) prev.addEventListener('click', function(){ show(i - 1); });
    if(next) next.addEventListener('click', function(){ show(i + 1); });
  });
})();
</script>

{% schema %}
{
  "name": "MT Cita destacada",
  "tag": "section",
  "class": "mt-section-reviews-long",
  "settings": [],
  "blocks": [
    {
      "type": "quote",
      "name": "Cita",
      "settings": [
        { "type": "text", "id": "headline", "label": "Frase destacada", "default": "Mi marido me preguntó qué estaba usando" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Testimonio completo." },
        { "type": "text", "id": "name", "label": "Nombre", "default": "Laura M." }
      ]
    }
  ],
  "presets": [{ "name": "MT Cita destacada" }]
}
{% endschema %}
