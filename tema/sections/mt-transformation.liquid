{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section">
  <div class="mt-wrap mt-pad">
    <h2 class="mt-story__heading">{{ section.settings.heading }}</h2>
    {% for block in section.blocks %}
      <p class="mt-p">{{ block.settings.text }}</p>
    {% endfor %}
    {% if section.settings.show_button %}
      <div style="margin-top:18px;">
        <button type="button" class="mt-btn" data-mt-story-cta>
          <span>{{ section.settings.button_text }}</span>
          <span class="mt-btn__arrow">→</span>
        </button>
      </div>
    {% endif %}
  </div>
</div>

<script>
(function(){
  document.querySelectorAll('[data-mt-story-cta]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = document.querySelector('[data-mt-buybox]');
      if(target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "MT Narrativa",
  "tag": "section",
  "class": "mt-section-transform",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "default": "El problema que ya conoces" },
    { "type": "checkbox", "id": "show_button", "label": "Mostrar botón", "default": false },
    { "type": "text", "id": "button_text", "label": "Texto del botón", "default": "Consigue el tuyo hoy" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Párrafo",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Texto del párrafo." }
      ]
    }
  ],
  "presets": [{ "name": "MT Narrativa" }]
}
{% endschema %}
