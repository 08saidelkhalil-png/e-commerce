{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-wrap--wide mt-pad">
    <div class="mt-transform">
      <div class="mt-transform__img">
        {% assign img = section.settings.image | default: product.images[4] %}
        {% if img %}
          <img src="{{ img | image_url: width: 800 }}" alt="" loading="lazy" width="800">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <p class="mt-transform__quote">{{ section.settings.quote }}</p>
        <p class="mt-p" style="margin-top:14px;">{{ section.settings.body }}</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MT Transformación",
  "tag": "section",
  "class": "mt-section-transform",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen (si se deja vacío, usa una foto del producto)" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "El problema que ya conoces" },
    { "type": "textarea", "id": "quote", "label": "Frase destacada", "default": "Imagina limpiar la ranura de tu ventana en 10 segundos, sin cuchillos ni trapos que no llegan al fondo." },
    { "type": "richtext", "id": "body", "label": "Texto", "default": "<p>Sabes de qué hablamos: esa línea negra de suciedad que se acumula en el carril y que ningún trapo saca del todo. Con el cepillo 2 en 1 encajas la cuña en la ranura, deslizas, y sale toda la mugre sin arriesgarte a rayar el aluminio ni hacerte daño en las uñas.</p>" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--sage", "label": "Verde salvia claro" }
      ],
      "default": "mt-section--sage"
    }
  ],
  "presets": [{ "name": "MT Descripción transformación" }]
}
{% endschema %}
