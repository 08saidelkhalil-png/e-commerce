{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-pad--sm">
    {% if section.settings.heading != blank %}
      <h2 class="mt-h2 mt-center">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="mt-guarantees">
      {% for block in section.blocks %}
        <div class="mt-guarantee" {{ block.shopify_attributes }}>
          <div class="mt-guarantee__icon">{{ block.settings.icon }}</div>
          <div class="mt-guarantee__label">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.show_customer_photos %}
      <div class="mt-customer-photos">
        {% for i in (1..4) %}
          {% assign img = product.images[i] %}
          {% if img %}
            <img src="{{ img | image_url: width: 200 }}" alt="Cliente real" loading="lazy" width="200" height="200">
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "MT Garantías",
  "tag": "section",
  "class": "mt-section-guarantee",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Compra 100% segura" },
    { "type": "checkbox", "id": "show_customer_photos", "label": "Mostrar fotos de clientes", "default": true },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--soft", "label": "Crema suave" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Garantía",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icono/emoji", "default": "🛡️" },
        { "type": "text", "id": "label", "label": "Texto", "default": "Garantía 30 días" }
      ]
    }
  ],
  "presets": [{ "name": "MT Garantía y prueba social" }]
}
{% endschema %}
