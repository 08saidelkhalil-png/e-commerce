{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-pad--sm mt-title-block">
    {% if section.settings.eyebrow != blank %}
      <span class="mt-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    <h2 class="mt-h2">{{ section.settings.heading | default: product.title }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="mt-p">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "MT Título producto",
  "tag": "section",
  "class": "mt-section-title",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Qué es y qué hace" },
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--soft", "label": "Crema suave" },
        { "value": "mt-section--sage", "label": "Verde salvia claro" }
      ],
      "default": ""
    }
  ],
  "presets": [{ "name": "MT Título de características" }]
}
{% endschema %}
