{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-pad">
    <div class="mt-hero">
      <div class="mt-hero__main">
        {% if section.settings.badge != blank %}
          <span class="mt-hero__badge">{{ section.settings.badge }}</span>
        {% endif %}
        {% assign main_image = section.settings.main_image | default: product.featured_image %}
        {% if main_image %}
          <img src="{{ main_image | image_url: width: 900 }}" alt="{{ main_image.alt | default: product.title }}" loading="eager" width="900" height="900">
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="mt-infografias">
        {% for block in section.blocks %}
          {% assign fallback = product.images[forloop.index] %}
          <div class="mt-infografia" {{ block.shopify_attributes }}>
            {% assign img = block.settings.image | default: fallback %}
            {% if img %}
              <img src="{{ img | image_url: width: 300 }}" alt="{{ block.settings.label }}" loading="lazy" width="300" height="300">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
            <div class="mt-infografia__label">{{ block.settings.label }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MT Foto + infografías",
  "tag": "section",
  "class": "mt-section-hero",
  "settings": [
    { "type": "image_picker", "id": "main_image", "label": "Foto principal (si se deja vacío, usa la foto destacada del producto)" },
    { "type": "text", "id": "badge", "label": "Distintivo sobre la foto", "default": "Más vendido" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--soft", "label": "Crema suave" },
        { "value": "mt-section--sage", "label": "Verde salvia claro" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "infografia",
      "name": "Infografía",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (si se deja vacío, usa una foto del producto)" },
        { "type": "text", "id": "label", "label": "Texto", "default": "Cómo funciona" }
      ]
    }
  ],
  "presets": [{ "name": "MT Foto + infografías" }]
}
{% endschema %}
