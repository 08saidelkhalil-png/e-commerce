{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-pad--sm">
    <div class="mt-benefits">
      {% for block in section.blocks %}
        <div class="mt-benefit" {{ block.shopify_attributes }}>
          <span class="mt-benefit__emoji">{{ block.settings.emoji }}</span>
          <span class="mt-benefit__text">{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MT Emoji benefits",
  "tag": "section",
  "class": "mt-section-benefits",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--soft", "label": "Crema suave" },
        { "value": "mt-section--sage", "label": "Verde salvia claro" }
      ],
      "default": "mt-section--soft"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "✅" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Beneficio" }
      ]
    }
  ],
  "presets": [{ "name": "MT Emoji benefits" }]
}
{% endschema %}
