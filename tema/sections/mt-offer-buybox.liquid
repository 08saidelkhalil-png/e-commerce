{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

{% assign current_variant = product.selected_or_first_available_variant %}

<div class="mt-section">
  <div class="mt-wrap mt-pad">
    <div data-mt-buybox>
      <div class="mt-divider">
        <span class="mt-divider__text">{{ section.settings.promo_text }}</span>
      </div>

      <form data-mt-form>
        <div class="mt-bundles" data-mt-bundles>
          {% for variant in product.variants %}
            <label class="mt-bundle{% if variant.id == current_variant.id %} is-selected{% endif %}" data-mt-bundle data-variant-id="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" data-available="{{ variant.available }}">
              <input type="radio" name="mt-variant" value="{{ variant.id }}" {% if variant.id == current_variant.id %}checked{% endif %}>
              {% if variant.title contains 'Pack' or variant.title contains 'pack' %}
                <span class="mt-bundle__badge">{{ section.settings.badge_text }}</span>
              {% endif %}
              <span class="mt-bundle__radio"></span>
              <span class="mt-bundle__label">{{ variant.title }}</span>
              <span class="mt-bundle__prices">
                <span class="mt-bundle__price">{{ variant.price | money }}</span>
                {% if variant.compare_at_price > variant.price %}
                  <span class="mt-bundle__compare">{{ variant.compare_at_price | money }}</span>
                {% endif %}
              </span>
            </label>
          {% endfor %}
        </div>

        <div class="mt-rewards">
          {% for block in section.blocks %}
            <div class="mt-reward" {{ block.shopify_attributes }}>
              {% case block.settings.icon %}
                {% when 'shipping' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="1" y="6" width="14" height="11" rx="1.5"/><path d="M15 10h4l3 3v4h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="17.5" cy="19" r="1.6"/></svg>
                {% when 'warranty' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 11 4.5-2.5 8-6 8-11V5z"/><path d="M9 12l2 2 4-4"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>
              {% endcase %}
              <div class="mt-reward__label">{{ block.settings.label }}</div>
            </div>
          {% endfor %}
        </div>

        <button type="submit" class="mt-btn" data-mt-add-btn>
          <span data-mt-add-label>{{ section.settings.button_text }}</span>
          <span class="mt-btn__arrow">→</span>
        </button>
      </form>

      <div class="mt-returns">
        <span>⇄</span>
        <span>{{ section.settings.returns_text }}</span>
      </div>

      <div class="mt-payments">
        <span>Visa</span><span>Mastercard</span><span>Amex</span><span>PayPal</span><span>Apple Pay</span>
      </div>

      {% if section.settings.show_scarcity %}
        <div class="mt-scarcity">
          <div class="mt-scarcity__bar"><div class="mt-scarcity__fill" style="width:{{ section.settings.scarcity_percent }}%"></div></div>
          <div class="mt-scarcity__row">
            <span>⚠️ {{ section.settings.scarcity_label }}</span>
            <span>{{ section.settings.scarcity_percent }}% agotado</span>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.querySelector('[data-mt-buybox]');
  if(!root) return;
  var form = root.querySelector('[data-mt-form]');
  var bundles = root.querySelectorAll('[data-mt-bundle]');
  var addBtn = root.querySelector('[data-mt-add-btn]');
  var addLabel = root.querySelector('[data-mt-add-label]');
  var addLabelDefault = addLabel ? addLabel.textContent.trim() : '';

  function selected(){
    return root.querySelector('[data-mt-bundle] input:checked').closest('[data-mt-bundle]');
  }

  function updateUI(){
    var el = selected();
    bundles.forEach(function(b){ b.classList.toggle('is-selected', b === el); });
    var available = el.dataset.available === 'true';
    addBtn.disabled = !available;
    if(addLabel) addLabel.textContent = available ? addLabelDefault : 'Agotado';
  }

  bundles.forEach(function(b){
    b.addEventListener('click', function(){
      b.querySelector('input').checked = true;
      updateUI();
    });
  });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var el = selected();
    if(!el || el.dataset.available !== 'true') return;
    addBtn.disabled = true;
    if(addLabel) addLabel.textContent = 'Añadiendo…';
    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: el.dataset.variantId, quantity: 1 })
    })
      .then(function(r){ if(!r.ok) throw new Error('add failed'); return r.json(); })
      .then(function(){ window.location.href = window.Shopify.routes.root + 'cart'; })
      .catch(function(){
        if(addLabel) addLabel.textContent = 'Error, prueba de nuevo';
        addBtn.disabled = false;
      });
  });

  updateUI();
})();
</script>

{% schema %}
{
  "name": "MT Compra",
  "tag": "section",
  "class": "mt-section-buybox",
  "settings": [
    { "type": "text", "id": "promo_text", "label": "Texto del divisor", "default": "Oferta especial" },
    { "type": "text", "id": "badge_text", "label": "Distintivo en el pack", "default": "MÁS POPULAR" },
    { "type": "text", "id": "button_text", "label": "Texto del botón", "default": "Añadir al carrito" },
    { "type": "text", "id": "returns_text", "label": "Texto de devolución", "default": "Garantía de devolución de 30 días" },
    { "type": "checkbox", "id": "show_scarcity", "label": "Mostrar barra de unidades", "default": true },
    { "type": "text", "id": "scarcity_label", "label": "Etiqueta de urgencia", "default": "Oferta por tiempo limitado" },
    { "type": "range", "id": "scarcity_percent", "label": "% agotado", "min": 10, "max": 95, "step": 5, "default": 70 }
  ],
  "blocks": [
    {
      "type": "reward",
      "name": "Icono de confianza",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icono",
          "options": [
            { "value": "shipping", "label": "Envío" },
            { "value": "warranty", "label": "Garantía" },
            { "value": "secure", "label": "Seguridad" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "label", "label": "Texto", "default": "Envío gratis" }
      ]
    }
  ],
  "presets": [{ "name": "MT Compra" }]
}
{% endschema %}
