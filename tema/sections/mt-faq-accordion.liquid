{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section {{ section.settings.background }}">
  <div class="mt-wrap mt-pad">
    {% if section.settings.heading != blank %}
      <h2 class="mt-h2 mt-center">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="mt-accordion">
      {% for block in section.blocks %}
        <details class="mt-accordion__item" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %}>
          <summary class="mt-accordion__q">
            <span>{{ block.settings.question }}</span>
            <span class="mt-accordion__icon">+</span>
          </summary>
          <div class="mt-accordion__a">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MT Preguntas frecuentes",
  "tag": "section",
  "class": "mt-section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" },
    {
      "type": "select", "id": "background", "label": "Fondo",
      "options": [
        { "value": "", "label": "Crema" },
        { "value": "mt-section--soft", "label": "Crema suave" }
      ],
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda el envío?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "Entre 24 y 48 horas laborables en península." }
      ]
    }
  ],
  "presets": [{ "name": "MT Preguntas frecuentes" }]
}
{% endschema %}
