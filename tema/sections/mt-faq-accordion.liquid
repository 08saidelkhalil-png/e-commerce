{{ 'mt-theme.css' | asset_url | stylesheet_tag }}

<div class="mt-section">
  <div class="mt-wrap mt-pad">
    <div class="mt-accordion">
      {% for block in section.blocks %}
        <details class="mt-accordion__item" {{ block.shopify_attributes }}>
          <summary class="mt-accordion__q">
            <span class="mt-accordion__q-icon">{{ block.settings.icon }}</span>
            <span class="mt-accordion__q-text">{{ block.settings.question }}</span>
            <span class="mt-accordion__chevron">⌄</span>
          </summary>
          <div class="mt-accordion__a">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MT Preguntas frecuentes",
  "tag": "section",
  "class": "mt-section-faq",
  "settings": [],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icono/emoji", "default": "❓" },
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuánto tarda el envío?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "Entre 24 y 48 horas laborables en península." }
      ]
    }
  ],
  "presets": [{ "name": "MT Preguntas frecuentes" }]
}
{% endschema %}
